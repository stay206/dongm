{
  "schemaVersion": 2,
  "mediaSources": [
    {
  "id": "ciyuan-cheng",
  "clientVersions": ">=6.3.0",
  "factoryId": "json-api",
  "version": 1,
  "arguments": {
    "name": "次元城动画",
    "description": "cycani.org。播放接口需要登录，请把 Authorization 里的 token 换成你自己的（网页登录后从 localStorage 的 cycweb:auth:v2 读取）。",
    "iconUrl": "https://www.cycani.org/favicon.ico",
    "tier": 0,
    "searchConfig": {
      "baseUrl": "https://www.cycani.org",
      "headers": "X-App-Name: cyc_web\nX-App-Version: cycweb\nX-Time-Zone: Asia/Shanghai",
      "requestInterval": 1000,
      "searchCacheTtl": 7200000,
      "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
      "defaultResolution": "1080P",
      "defaultSubtitleLanguage": "CHS",
      "autoMatch": {
        "enabled": true,
        "searchUseSubjectNamesCount": 3,
        "preferShorterName": true,
        "filterByEpisodeSort": true
      },
      "search": {
        "request": {
          "url": "/api/videos/search?q={keyword}&page={page}&page_size={pageSize}",
          "method": "GET",
          "headers": "",
          "body": ""
        },
        "pageSize": 24,
        "selectItems": "$.data.list[*]",
        "selectName": "$.title",
        "selectId": "$.video_id",
        "selectAliases": "",
        "subjectUrlTemplate": "https://www.cycani.org/anime/{id}"
      },
      "subject": {
        "request": {
          "url": "/api/videos/{id}/sections?player_code=cychub&page=1&page_size=100",
          "method": "GET",
          "headers": "",
          "body": ""
        },
        "channelFormatId": "no-channel",
        "episodes": {
          "selectEpisodes": "$.data.list[*]",
          "selectName": "$.title",
          "selectId": "$.id",
          "selectSort": "",
          "selectType": "",
          "typeMapping": "",
          "matchEpisodeSortFromName": "(?<ep>\\d+(?:\\.\\d+)?)",
          "nameTemplate": "{name}",
          "episodeUrlTemplate": "https://www.cycani.org/anime/{subjectId}/play/{id}",
          "selectVideoUrl": ""
        }
      },
      "play": {
        "request": {
          "url": "/api/v2/sections/{id}/play-url",
          "method": "GET",
          "headers": "Authorization: Bearer <把你的 cycani 登录 token 填在这里>",
          "body": ""
        },
        "selectCandidates": "",
        "selectCandidateChannel": "",
        "selectVideoUrl": "$.data.url",
        "fallbackToFirstCandidate": true,
        "referer": "https://www.cycani.org/",
        "videoHeaders": "Origin: https://www.cycani.org"
      }
    }
  }
}
    ]
  }

